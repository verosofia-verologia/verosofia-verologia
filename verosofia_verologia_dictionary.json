  "axioms": [
    {
      "name": "Аксиома 14 (Принцип обязательного разнообразия)",
      "definition": "Запрещает полную идентичность и строгую фрактальную итеративность в хроногеометрических лакунах. Обеспечивает наличие «отклонений от Алфавита»."
    },
    {
      "name": "Аксиома 15 (Двойное свидетельство)",
      "definition": "Одновременное и изоморфное проявление одного информационного паттерна в материальном и ментальном каналах. Критерий истинности."
    },
    {
      "name": "Аксиома 16 (Гармоническое разрешение)",
      "definition": "Устойчивое существование составного явления возможно только при разрешении внутреннего диссонанса в консонанс (σ = 1/2). Любой дефект немедленно инвертируется в структурную энергичность через ИДМ."
    },
    {
      "name": "Аксиома 17 (Принцип когерентного резонанса)",
      "definition": "Любая устойчивая система достигает максимальной эффективности при резонансе её частоты с фундаментальной частотой ГВК."
    },
    {
      "name": "Аксиоматическое соглашение",
      "definition": "Любая аксиома в словаре понимается как конвенционально принятая для данного уровня рассуждения."
    },
    {
      "name": "Конвенция",
      "definition": "Основание аксиоматики."
    },
    {
      "name": "Догма",
      "definition": "Некорректно вменённая аксиома."
    },
    {
      "name": "Доказательство",
      "definition": "Условный способ обоснования, действительный в рамках избранной темы."
    }
  ],
  "formulaIndex": [
    "Λ_AI = dG_munu_AI / dI_AI",
